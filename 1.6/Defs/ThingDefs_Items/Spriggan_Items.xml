	<ThingDef ParentName="ESCP_SprigganTreeSeedBase">
		<defName>ESCP_SprigganTreeSeed</defName>
		<label>spriggan tree seed</label>
		<description>The seed of a spriggan tree. It can be planted to create a new spriggan tree, from which friendly spriggans will periodically emerge.</description>
		<descriptionHyperlinks>
		  <ThingDef>ESCP_SprigganTree</ThingDef>
		</descriptionHyperlinks>
		<graphicData>
		  <texPath>Things/Item/Resource/ESCP_SprigganSeed/SprigganSeeds</texPath>
		</graphicData>
		<comps>
		  <li Class="CompProperties_Plantable">
			<plantDefToSpawn>ESCP_SprigganTree</plantDefToSpawn>
		  </li>
		</comps>
		<costList>
		  <ESCP_SprigganTaproot>1</ESCP_SprigganTaproot>
		</costList>
	</ThingDef>

